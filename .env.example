# Copy to .env. Never commit the real file.

TEST_ENV=qa
BASE_URL=https://qa-api.example.com

# Database access for oracle checks. Use a read-only role.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Local demo stack (demo/docker-compose.yml). These are the values the bundled
# tests/demo suite expects; they point at containers on your own machine.
# ---------------------------------------------------------------------------
# BASE_URL=http://localhost:8000
# DEMO_DB_DSN=postgresql://oracle:oracle@localhost:5432/demo
# REDIS_URL=redis://localhost:6379/0
